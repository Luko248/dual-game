{
  "name": "dual",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync",
    "cap:ios": "vite build && cap sync ios && cap open ios",
    "cap:android": "vite build && cap sync android && cap open android",
    "release:testflight": "./scripts/publish-testflight.sh",
    "assets:generate": "capacitor-assets generate --ios --android --iconBackgroundColor '#05050a' --iconBackgroundColorDark '#05050a' --splashBackgroundColor '#05050a' --splashBackgroundColorDark '#05050a'"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
