<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template — do not edit in place. scripts/publish-testflight.sh copies this
  to a scratch dir and substitutes __TEAM_ID__ with $DEVELOPMENT_TEAM before
  passing it to `xcodebuild -exportArchive`.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
</dict>
</plist>
